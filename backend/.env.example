# Copy to backend/.env and fill in real values (backend/.env is gitignored).

# XTS internal app credentials (server-to-server; from QuantTrade Admin Apps)
XTS_APP_KEY=qt_key_xxxxxxxxxxxxxxxxx
XTS_APP_PASSWORD=qt_app_xxxxxxxxxxxxxxxxx

# Gateway + XTS
QT_GATEWAY_BASE=https://quantapi.phoneme.in
XTS_MD_BASE=https://ttblaze.iifl.com/apimarketdata
XTS_MODE=direct

# Market-open OI baseline: auto-capture at 09:16 IST on weekdays
BASELINE_AUTOCAPTURE=true
# Optional: restrict/extend the capture set (comma list, or "all")
# BASELINE_UNDERLYINGS=NIFTY,BANKNIFTY,RELIANCE
# Optional: protect the manual capture endpoint
# BASELINE_ADMIN_TOKEN=change-me

# Frontend origin for CORS (set to the staging frontend URL)
FRONTEND_ORIGIN=http://localhost:3000
